---
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ittichai Boonyarakthunya · Software Engineer · Bangkok',
  description = 'Ittichai Boonyarakthunya — Mid-level full-stack engineer based in Bangkok. 5+ years shipping production web.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="initial-scale=1, width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />

    <!-- Roboto Mono font — only the weights globals.css uses (400/600/700) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Devicons — loaded without blocking first render (ticker only) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.15.1/devicon.min.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.15.1/devicon.min.css"
      />
    </noscript>
  </head>
  <body id="top">
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
