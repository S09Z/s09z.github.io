  <!-- Custom cursor -->
  <div class="cursor-ring" id="cring"></div>
  <div class="cursor-dot"  id="cdot"></div>

  <!-- Back to top -->
  <a href="#top" class="back-to-top" aria-label="Back to top">
    <span>↑</span>
    <span style="font-size:0.5rem; margin-top:1px;">top</span>
  </a>

  <script>
    /* Live clock */
    const clockEl = document.getElementById('clock');
    setInterval(() => {
      if (!clockEl) return;
      const d = new Date();
      const opts: Intl.DateTimeFormatOptions = {
        hour: '2-digit', minute: '2-digit', second: '2-digit',
        hour12: false, timeZone: 'Asia/Bangkok',
      };
      clockEl.textContent = d.toLocaleTimeString('en-GB', opts) + ' ICT';
    }, 1000);

    /* Custom cursor + liquid text run only with a fine pointer on wide
       screens, and never under prefers-reduced-motion. Keep this query in
       sync with the `.cursor-ring, .cursor-dot` media query in globals.css. */
    const fancyMQ = window.matchMedia(
      '(hover: hover) and (pointer: fine) and (min-width: 901px) and (prefers-reduced-motion: no-preference)'
    );

    /* Custom cursor: ring (spring) + dot (instant) */
    const ring = document.getElementById('cring')!;
    const dot  = document.getElementById('cdot')!;
    let mx = window.innerWidth / 2, my = window.innerHeight / 2;
    let rx = mx, ry = my;

    /* Grow ring on interactive elements */
    document.querySelectorAll('a, button').forEach((el) => {
      el.addEventListener('mouseenter', () => ring.classList.add('hover'));
      el.addEventListener('mouseleave', () => ring.classList.remove('hover'));
    });

    /* Liquid text distortion on [data-liq] elements.
       Each text run is split into per-char spans inside an aria-hidden
       wrapper, next to an sr-only copy, so screen readers read words
       instead of spelling them out letter by letter. */
    type Ch = { el: HTMLElement; x: number; y: number; on: boolean };
    let chars: Ch[] = [];
    let split = false;

    function splitChars() {
      const out: Ch[] = [];
      const walk = (node: Node) => {
        if (node.nodeType === 3) {
          /* Collapse HTML indentation whitespace (newlines + multi-space)
             into a single space, then skip purely-whitespace nodes. */
          const text = (node.textContent ?? '')
            .replace(/[\n\r\t]+/g, ' ')
            .replace(/ {2,}/g, ' ');
          if (!text.trim()) return;
          const sr = document.createElement('span');
          sr.className = 'sr-only';
          sr.textContent = text;
          const visual = document.createElement('span');
          visual.setAttribute('aria-hidden', 'true');
          for (const c of [...text]) {
            if (c === ' ') {
              visual.appendChild(document.createTextNode(' '));
            } else {
              const s = document.createElement('span');
              s.className = 'ch';
              s.textContent = c;
              visual.appendChild(s);
              out.push({ el: s, x: 0, y: 0, on: false });
            }
          }
          const frag = document.createDocumentFragment();
          frag.append(sr, visual);
          node.parentNode!.replaceChild(frag, node);
        } else if (node.nodeType === 1) {
          [...node.childNodes].forEach(walk);
        }
      };
      document.querySelectorAll('[data-liq]').forEach(walk);
      return out;
    }

    function resetChars() {
      for (const c of chars) {
        if (!c.on) continue;
        c.el.style.transform = '';
        c.el.style.color = '';
        c.on = false;
      }
    }

    /* Cache each char's page-space centre so the per-frame work is pure
       math — no getBoundingClientRect (forced layout) inside the loop. */
    function measure() {
      resetChars();
      for (const c of chars) {
        const r = c.el.getBoundingClientRect();
        c.x = r.left + r.width / 2 + window.scrollX;
        c.y = r.top + r.height / 2 + window.scrollY;
      }
    }

    function liquify() {
      const R = 140;
      const px = mx + window.scrollX, py = my + window.scrollY;
      for (const c of chars) {
        const dx = c.x - px, dy = c.y - py;
        const d = Math.abs(dx) < R && Math.abs(dy) < R ? Math.hypot(dx, dy) : R;
        if (d < R) {
          const f   = 1 - d / R;
          const ang = Math.atan2(dy, dx);
          const ox  = Math.cos(ang) * 18 * f;
          const oy  = Math.sin(ang) * 18 * f;
          const sc  = 1 + f * 0.5;
          const rot = (dx / R) * 8 * f;
          c.el.style.transform = `translate(${ox}px,${oy}px) scale(${sc}) rotate(${rot}deg)`;
          c.el.style.color = `oklch(${0.74 + f * 0.1} 0.18 295)`;
          c.on = true;
        } else if (c.on) {
          c.el.style.transform = '';
          c.el.style.color = '';
          c.on = false;
        }
      }
    }

    /* Frames run only while something changed: the pointer moved, the page
       scrolled or resized, or the ring is still catching up. */
    let enabled = false;
    let raf = 0;
    let dirty = true;
    let needsMeasure = true;

    function frame() {
      raf = 0;
      if (needsMeasure) { measure(); needsMeasure = false; dirty = true; }
      rx += (mx - rx) * 0.18;
      ry += (my - ry) * 0.18;
      ring.style.transform = `translate(${rx}px,${ry}px) translate(-50%,-50%)`;
      if (dirty) { liquify(); dirty = false; }
      if (Math.abs(mx - rx) > 0.1 || Math.abs(my - ry) > 0.1) schedule();
    }

    function schedule() {
      if (enabled && !raf) raf = requestAnimationFrame(frame);
    }

    window.addEventListener('mousemove', (e) => {
      if (!enabled) return;
      mx = e.clientX; my = e.clientY;
      dot.style.transform = `translate(${mx}px,${my}px) translate(-50%,-50%)`;
      dirty = true;
      schedule();
    });

    window.addEventListener('scroll', () => { dirty = true; schedule(); }, { passive: true });

    /* Re-measure whenever layout can have moved the text (resize, late
       font / icon loads changing the page height). */
    const remeasure = () => { needsMeasure = true; schedule(); };
    new ResizeObserver(remeasure).observe(document.body);
    document.fonts?.ready.then(remeasure);

    function applyMode() {
      enabled = fancyMQ.matches;
      if (enabled) {
        if (!split) { chars = splitChars(); split = true; }
        remeasure();
      } else {
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
        resetChars();
      }
    }
    fancyMQ.addEventListener('change', applyMode);
    applyMode();
  </script>

</Layout>
